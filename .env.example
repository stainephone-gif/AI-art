# === Вариант 2: Groq (прямой ключ gsk_...) ===
# OPENROUTER_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
# API_BASE_URL=https://api.groq.com/openai/v1/chat/completions
# OPENROUTER_MODEL=llama-3.3-70b-versatile
# Other Groq models:
# - llama-3.1-8b-instant
# - mixtral-8x7b-32768
# - gemma2-9b-it

# Активная конфигурация (раскомментируйте нужный вариант выше и заполните ключ):
OPENROUTER_API_KEY=your_api_key_here
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Optional: HTTP headers (только для OpenRouter)
HTTP_REFERER=http://localhost:3000
X_TITLE=Enhanced Consciousness Classifier
