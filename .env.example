# === Вариант 1: OpenRouter ===
# ВАЖНО ДЛЯ ВОСПРОИЗВОДИМОСТИ: используйте версионированные ID моделей,
# а не алиасы. Алиасы (без даты/версии) дрейфуют со временем — через
# несколько месяцев та же команда даст другие результаты.
#
# OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxx
# OPENROUTER_MODEL=anthropic/claude-sonnet-4-5-20250929   # ← версионированный
# AVOID: anthropic/claude-sonnet-4-latest                  # ← алиас, дрейфует
#
# Точные ID смотрите на https://openrouter.ai/models

# === Вариант 2: Groq (прямой ключ gsk_...) ===
# OPENROUTER_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
# API_BASE_URL=https://api.groq.com/openai/v1/chat/completions
# OPENROUTER_MODEL=llama-3.3-70b-versatile
# Other Groq models:
# - llama-3.1-8b-instant
# - mixtral-8x7b-32768
# - gemma2-9b-it

# Активная конфигурация (раскомментируйте нужный вариант выше и заполните ключ):
OPENROUTER_API_KEY=your_api_key_here
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Пауза между запросами в секундах (увеличьте при ошибках Rate limit)
# Groq бесплатный тариф: рекомендуется 2.0–3.0
# OpenRouter: можно оставить 0.5
RATE_LIMIT_DELAY=2.0

# Optional: HTTP headers (только для OpenRouter)
HTTP_REFERER=http://localhost:3000
X_TITLE=Enhanced Consciousness Classifier
